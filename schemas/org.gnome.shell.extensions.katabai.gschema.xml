<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.katabai" path="/org/gnome/shell/extensions/katabai/">
    <key name="provider" type="s">
      <default>'unsloth'</default>
      <summary>AI Model Provider</summary>
      <description>The AI provider to use. Valid values are 'ollama', 'unsloth', 'openai', or 'anthropic'.</description>
    </key>
    <key name="toggle-current-chat" type="as">
      <default>["&lt;Control&gt;&lt;Super&gt;c"]</default>
      <summary>Toggle Current Chat</summary>
      <description>Keyboard shortcut to open or hide the current Katab chat while keeping active responses running in the background.</description>
    </key>
    <key name="document-tool-enabled" type="b">
      <default>false</default>
      <summary>Enable Document Tool</summary>
      <description>Enable optional local document parsing for supported text, PDF, and DOCX files.</description>
    </key>
    
    <!-- Ollama Settings -->
    <key name="ollama-url" type="s">
      <default>'http://localhost:11434'</default>
      <summary>Ollama Base URL</summary>
      <description>The base URL for the Ollama API.</description>
    </key>
    <key name="ollama-model" type="s">
      <default>'llama3'</default>
      <summary>Ollama Model</summary>
      <description>The model to use with Ollama.</description>
    </key>
    <key name="ollama-preset" type="s">
      <default>'balanced'</default>
      <summary>Ollama Workload Preset</summary>
      <description>Preset profile that adjusts Ollama sampling for common workloads.</description>
    </key>
    <key name="ollama-num-ctx" type="i">
      <default>4096</default>
      <summary>Context Window Size</summary>
      <description>The context window size for the Ollama model (e.g., 4096, 8192).</description>
    </key>
    <key name="ollama-num-predict" type="i">
      <default>-1</default>
      <summary>Max Generation Tokens (num_predict)</summary>
    </key>
    <key name="ollama-num-keep" type="i">
      <default>0</default>
      <summary>Retained System Tokens (num_keep)</summary>
    </key>
    <key name="ollama-keep-alive" type="s">
      <default>'5m'</default>
      <summary>Keep Alive Duration</summary>
      <description>How long to retain the model in VRAM (e.g., '5m', '0' to unload immediately, '-1' for indefinite).</description>
    </key>
    <key name="ollama-format" type="s">
      <default>''</default>
      <summary>Structured Response Format</summary>
      <description>Optional top-level Ollama format override. Use 'json' to request valid JSON output.</description>
    </key>
    <key name="ollama-raw" type="b">
      <default>false</default>
      <summary>Raw Prompt Mode</summary>
      <description>Disables model chat templating when enabled.</description>
    </key>
    
    <!-- Ollama Memory & Hardware -->
    <key name="ollama-use-mmap" type="b">
      <default>true</default>
      <summary>Use Memory Mapping (mmap)</summary>
    </key>
    <key name="ollama-use-mlock" type="b">
      <default>false</default>
      <summary>Lock in Physical RAM (mlock)</summary>
    </key>
    <key name="ollama-num-gpu" type="i">
      <default>-1</default>
      <summary>GPU Layers to Offload</summary>
    </key>
    <key name="ollama-num-thread" type="i">
      <default>4</default>
      <summary>CPU Thread Allocation</summary>
    </key>

    <!-- Ollama Statistical Sampling -->
    <key name="ollama-temperature" type="d">
      <default>0.7</default>
      <summary>Temperature</summary>
      <description>The temperature for model generation (e.g., 0.7 for balance, 0.0 for deterministic).</description>
    </key>
    <key name="ollama-top-k" type="i">
      <default>40</default>
      <summary>Top-K</summary>
    </key>
    <key name="ollama-top-p" type="d">
      <default>0.9</default>
      <summary>Top-P (Nucleus Sampling)</summary>
    </key>
    <key name="ollama-min-p" type="d">
      <default>0.05</default>
      <summary>Min-P</summary>
    </key>
    <key name="ollama-tfs-z" type="d">
      <default>1.0</default>
      <summary>Tail Free Sampling</summary>
    </key>
    <key name="ollama-typical-p" type="d">
      <default>1.0</default>
      <summary>Typical-P</summary>
    </key>

    <!-- Ollama Dynamic Entropy (Mirostat) -->
    <key name="ollama-mirostat" type="i">
      <default>0</default>
      <summary>Mirostat Version</summary>
    </key>
    <key name="ollama-mirostat-tau" type="d">
      <default>5.0</default>
      <summary>Mirostat Target Entropy (tau)</summary>
    </key>
    <key name="ollama-mirostat-eta" type="d">
      <default>0.1</default>
      <summary>Mirostat Learning Rate (eta)</summary>
    </key>

    <!-- Ollama Degeneration and Loop Mitigation -->
    <key name="ollama-repeat-last-n" type="i">
      <default>64</default>
      <summary>Lookback Window size</summary>
    </key>
    <key name="ollama-repeat-penalty" type="d">
      <default>1.1</default>
      <summary>Repeat Penalty (Multiplicative)</summary>
    </key>
    <key name="ollama-presence-penalty" type="d">
      <default>0.0</default>
      <summary>Presence Penalty (Subtractive Boolean)</summary>
    </key>
    <key name="ollama-frequency-penalty" type="d">
      <default>0.0</default>
      <summary>Frequency Penalty (Subtractive Scaling)</summary>
    </key>

    <!-- Unsloth Settings -->
    <key name="unsloth-url" type="s">
      <default>'http://localhost:8888/v1'</default>
      <summary>Unsloth Base URL</summary>
      <description>The base URL for the Unsloth Studio API.</description>
    </key>
    <key name="unsloth-api-key" type="s">
      <default>''</default>
      <summary>Unsloth API Key</summary>
      <description>The API key for Unsloth Studio.</description>
    </key>
    <key name="unsloth-model" type="s">
      <default>'default'</default>
      <summary>Unsloth Model</summary>
      <description>The specific local model to run through Unsloth.</description>
    </key>
    <key name="unsloth-num-ctx" type="i">
      <default>8192</default>
      <summary>Context Window Size</summary>
      <description>The context window size configured in Unsloth Studio (e.g., 8192, 131072).</description>
    </key>

    <!-- OpenAI Settings -->
    <key name="openai-url" type="s">
      <default>'https://api.openai.com/v1'</default>
      <summary>OpenAI Base URL</summary>
      <description>The base URL for the OpenAI API.</description>
    </key>
    <key name="openai-api-key" type="s">
      <default>''</default>
      <summary>OpenAI API Key</summary>
      <description>The API key for OpenAI.</description>
    </key>
    <key name="openai-model" type="s">
      <default>'gpt-4o'</default>
      <summary>OpenAI Model</summary>
      <description>The model to use with OpenAI.</description>
    </key>

    <!-- Anthropic Settings -->
    <key name="anthropic-url" type="s">
      <default>'https://api.anthropic.com'</default>
      <summary>Anthropic Base URL</summary>
      <description>The base URL for the Anthropic API.</description>
    </key>
    <key name="anthropic-api-key" type="s">
      <default>''</default>
      <summary>Anthropic API Key</summary>
      <description>The API key for Anthropic.</description>
    </key>
    <key name="anthropic-model" type="s">
      <default>'claude-3-5-sonnet-20241022'</default>
      <summary>Anthropic Model</summary>
      <description>The model to use with Anthropic.</description>
    </key>
  </schema>
</schemalist>
